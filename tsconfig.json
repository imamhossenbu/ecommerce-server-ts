{
  "compilerOptions": {
    "target": "ES2022",                                  
    "module": "NodeNext",                                
    "moduleResolution": "NodeNext",                      
    "rootDir": "./src",                                  
    "outDir": "./dist",                                  
    "sourceMap": true,                                   
    "removeComments": true,                              
    "noEmitOnError": true,                               
    "esModuleInterop": true,                             
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                      
    "skipLibCheck": true,                                
    "resolveJsonModule": true,                           
    "declaration": true                                  
  },
  "include": ["src/**/*", "types/**/*.d.ts"],                               
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]    
}